      "hook_result_or_number_size": "32-80",
      "rule": "Create contrast with no more than three simultaneous size levels. Increase only the semantic payload, not filler words."
    },
    "layout_forms": [
      "Two-line centered hook with the result or conflict on line two.",
      "Stable lower-third spoken subtitle plus a separate upper keyword layer.",
      "Left-right paired comparison labels.",
      "Three-row numbered method list with aligned x and stepped y anchors.",
      "Oversized number plus smaller unit or conclusion.",
      "Short side label for identity, profession, or chapter change.",
      "Persistent top topic header only when the video is comparison-led.",
      "Vertical side teaser only for deliberate serial-content endings."
    ],
    "motion_rules": [
      "Animate semantic hits, not every spoken subtitle.",
      "Use fade, character reveal, or random rise for reflective and emotional content.",
      "Use zoom, shrink, roll, shout wave, or glow blur for conflict, data, and sales energy.",
      "Use reveal and slide motions for lists, steps, chapters, and professional explanations.",
      "Keep a strong entrance to roughly 0.25-0.5 seconds; let the text remain static long enough to read.",
      "Do not pair an unresolved native animation with every subtitle; one missing cache path can break the whole repeated style."
    ],
    "cover_rules": [
      "Use one audience/topic line and one conflict/result line.",
      "Make the second line the dominant typographic mass.",
      "Keep numbers, price gaps, warnings, and outcome words in the accent color.",
      "Avoid copying timeline captions onto the cover; rewrite them as a compact promise or contradiction."
    ]
  },
