  "usage_rules": [
    "Select a preset by use_when and semantic role, not by example text alone.",
    "Replace <TEXT>, <FONT_PATH>, range placeholders, position variants, and animation resource paths.",
    "Resolve every $ref against this JSON document before writing draft_content.json.",
    "Serialize material.content as a JSON string in materials.texts; it is an object here only for readability.",
    "Generate a fresh runtime id for every material, animation pack, and segment.",
    "Keep times in microseconds and validate material_id plus extra_material_refs.",
    "Do not add strokes or text effects: this profile uses fill, shadow, background, scale, position, and animation.",
    "Only attach native animations after resolving a valid local Jianying cache path. Omit unresolved animations."
  ],
  "composition_engine": {
    "mode": "automatic_by_default",
    "intent": "Turn a script into a restrained multi-track subtitle composition without waiting for the user to name individual presets.",
    "activate_when": [
      "The user asks to style, package, enhance, or add subtitles to a knowledge-payment, founder-IP, startup, business, or editing-education talking-head draft.",
      "The user asks to apply this skill or a distilled template to a draft.",
      "The user asks for editing and the draft contains speech-led text or transcribed captions."
    ],
    "opt_out_when": [
      "The user explicitly requests plain, minimal, single-style, or accessibility-only captions.",
      "The user explicitly locks a supplied design and forbids additional emphasis layers."
    ],
    "workflow": [
      "Read the complete spoken text in timeline order and divide it into semantic beats before selecting visual styles.",
      "Choose one subprofile from profile_selection and keep its base subtitle preset as the continuous visual identity.",
      "Mark each beat as hook, audience, authority, pain, pain_cluster, turn, solution, method, comparison, proof, identity, result, CTA, or transition.",
      "Select the strongest matching combination_recipe for each passage; do not choose styles only because example wording looks similar.",
      "Keep ordinary explanation on the base subtitle track. Replace or temporarily suppress duplicate base text when a large overlay carries the same words.",
      "Resolve local fonts, animation paths, text shapes, and optional sound assets. Fall back to portable keyframes or static emphasis when a native resource is unresolved.",
      "Run density, collision, readability, and reference-integrity checks before saving the draft."
    ],
    "profile_selection": {
      "lime-commercial-founder-ip": {
        "signals": ["创始人IP", "实体老板", "商业方法", "AI提效", "企业案例", "方法论", "获客", "老板出镜"],
        "base_preset": "spoken_subtitle",
        "accent_family": ["hook_two_tone_title", "audience_tag", "authority_name", "pain_conflict_large", "pain_barrage", "solution_keyword", "method_step", "proof_number", "cta_partial_highlight"]
      },
      "orange-high-contrast-editing-education": {
        "signals": ["剪辑教学", "价格对比", "能力差距", "案例拆解", "爆款", "关键信息", "音效", "下期揭秘"],
        "base_preset": "plain_spoken_subtitle_shadow",
        "accent_family": ["persistent_topic_header_orange", "section_label_fold", "animated_sentence_emphasis_orange", "paired_micro_bubble_tags", "oversized_keyword_hit_yellow", "next_episode_vertical_teaser"]
      },
      "red-yellow-startup-opportunity-warning": {
        "signals": ["创业机会", "风险警示", "骗局", "AI赛道", "赚钱角色", "行业加AI", "变现", "咨询落地"],
        "base_preset": "startup_plain_narrative_subtitle",
        "accent_family": ["startup_warning_red_oversized", "startup_opportunity_label_pale_yellow", "startup_combination_formula_card", "startup_result_hit_coral", "startup_identity_ribbon_red", "startup_chat_bubble_cta"]
      }
    },
    "combination_recipes": [
      {
        "key": "hook_identity_open",
        "use_when": "The opening contains a topic promise plus a clearly named audience or identity.",
        "roles": ["hook", "audience"],
        "preset_sequence": ["hook_two_tone_title", "audience_tag"],
        "timing": "Place the main hook in the first 0.2 to 0.8 seconds; introduce the audience tag within the next 0.5 to 1.5 seconds and keep both readable without covering the face.",
        "sound_role": "optional_hook_hit"
      },
      {
        "key": "authority_to_conclusion",
        "use_when": "A named person, company, expert, or case is immediately followed by a takeaway.",
        "roles": ["authority", "solution"],
        "preset_sequence": ["authority_name", "solution_keyword"],
        "timing": "Show the authority label briefly, then replace it with the conclusion instead of stacking both for the full sentence.",
        "sound_role": "optional_identity_or_keyword_hit"
      },
      {
        "key": "pain_pressure_stack",
        "use_when": "A passage states one core objection and then lists at least three short costs, failures, or negative consequences.",
        "roles": ["pain", "pain_cluster"],
        "preset_sequence": ["pain_conflict_large", "pain_barrage"],
        "timing": {
          "core_pain_hold_s": [1.2, 2.5],
          "barrage_item_count": [3, 4],
          "barrage_segment_duration_s": [0.9, 1.3],
          "barrage_stagger_s": [0.15, 0.35],
          "barrage_loop_animation_duration_s": 1.7,
          "source_example_positions": [
            {"x": -0.390776699029126, "y": 0.381991814461119},
            {"x": 0.359874904155731, "y": 0.180081855388813},
            {"x": 0.0, "y": 0.668485675306958}
          ]
        },
        "editing_rule": "Use short noun or verb phrases. Allow a small overlap between neighboring barrage items, but never cover the speaker's eyes or the base subtitle.",
        "sound_role": "optional_barrage_swishes_or_ticks"
      },
      {
        "key": "solution_method_proof",
        "use_when": "The script turns from a problem to a method, enumerates two or more steps, and provides a number or case result.",
        "roles": ["turn", "solution", "method", "proof"],
        "preset_sequence": ["solution_keyword", "method_step", "proof_number"],
        "timing": "Give the solution its own beat, assemble method items into stable rows, then reserve a separate beat for proof. Do not animate every continuation segment.",
        "sound_role": "optional_solution_hit_then_light_step_ticks"
      },
      {
        "key": "comparison_teaching",
        "subprofile": "orange-high-contrast-editing-education",
        "use_when": "The script compares prices, people, tools, abilities, or two editing approaches.",
        "roles": ["hook", "comparison", "keyword", "result"],
        "preset_sequence": ["persistent_topic_header_orange", "section_label_fold", "paired_micro_bubble_tags", "animated_sentence_emphasis_orange", "oversized_keyword_hit_yellow"],
        "editing_rule": "Keep the topic header persistent but quiet. Use section labels only at object changes, paired bubbles only for true two-item comparisons, and one oversized result at the strongest conclusion.",
        "sound_role": "optional_section_fold_and_result_hit"
      },
      {
        "key": "warning_opportunity_formula_result",
        "subprofile": "red-yellow-startup-opportunity-warning",
        "use_when": "The passage moves from risk or myth to an opportunity category, then explains a combination formula and its outcome.",
        "roles": ["pain", "solution", "method", "result"],
        "preset_sequence": ["startup_warning_red_oversized", "startup_opportunity_label_pale_yellow", "startup_combination_formula_card", "startup_result_hit_coral"],
        "editing_rule": "Use the oversized warning once near the opening. Keep the formula readable for the full spoken phrase and delay the result hit until the outcome is spoken.",
        "sound_role": "warning_hit_then_formula_reveal_then_result_hit"
      },
      {
        "key": "identity_to_cta",
        "use_when": "The ending names who the viewer can become and invites consultation, a message, a download, or a next step.",
        "roles": ["identity", "CTA"],
        "preset_options": [
          ["audience_tag", "cta_partial_highlight"],
          ["startup_identity_ribbon_red", "startup_chat_bubble_cta"]
        ],
        "editing_rule": "Choose the option that matches the active subprofile. Do not invent a CTA when the script has none.",
        "sound_role": "optional_soft_cta_pop"
      }
    ],
    "density_budget": {
      "per_30_seconds": {
        "base_subtitle": "continuous except where deliberately replaced by a semantic overlay",
        "opening_hook": [0, 1],
        "large_keyword_or_warning": [2, 4],
        "pain_barrage_group": [0, 1],
        "method_or_comparison_group": [0, 1],
        "proof_number": [0, 2],
        "CTA": [0, 1]
      },
      "minimum_gap_between_large_hits_s": 1.2,
      "max_simultaneous_text_layers": 3,
      "rule": "Prefer one complete semantic combination over many unrelated animated captions."
    },
    "collision_and_readability": [
      "Reserve one stable lower-third zone for base subtitles.",
      "Use upper, side, or staggered zones for semantic overlays and keep the speaker's eyes and mouth unobstructed.",
      "Do not show two large emphasis presets simultaneously unless the recipe explicitly defines a paired layout.",
      "Keep short impact text to roughly 2 to 8 Chinese characters per line; split longer thoughts into a base caption plus a short keyword.",
      "Remove sentence-final Chinese periods and commas from display blocks when they do not carry meaning.",
      "Use no more than three font families in one video: one base family, one display family, and an optional numeric or Latin-heavy family.",
      "Treat colored timeline clips as editor UI metadata, not rendered text backgrounds."
    ],
    "selection_fallbacks": [
      "If semantic confidence is low, retain the base subtitle and add no large overlay.",
      "If only one negative consequence exists, use pain_conflict_large without pain_barrage.",
      "If fewer than two method items exist, use solution_keyword instead of method_step.",
      "If no verifiable number or case exists, omit proof_number.",
      "If the user supplies an existing visual system, adapt recipe roles to it instead of replacing it wholesale."
    ]
  },
